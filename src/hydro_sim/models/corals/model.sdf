<?xml version="1.0"?>

<sdf version="1.10">

  <model name="corals">

    <static>true</static>

    <link name="coral">

      <collision name="collision">

        <geometry>

          <box>

            <size>0.8 0.8 1.0</size>

          </box>

        </geometry>

      </collision>

      <visual name="visual">

        <geometry>

          <mesh>

            <uri>model://corals/meshes/coral.obj</uri>

            <scale>4 4 4</scale>

          </mesh>

        </geometry>

      </visual>

    </link>

  </model>

</sdf>