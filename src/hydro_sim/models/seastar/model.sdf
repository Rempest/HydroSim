<?xml version="1.0"?>

<sdf version="1.10">

<model name="seastar">

  <static>true</static>

  <link name="seastar">

    <collision name="collision">

      <geometry>

        <box>

          <size>0.4 0.4 0.1</size>

        </box>

      </geometry>

    </collision>

    <visual name="visual">

      <geometry>

        <mesh>

          <uri>model://seastar/meshes/seastar.obj</uri>

          <scale>1 1 1</scale>

        </mesh>

      </geometry>

    </visual>

  </link>

</model>

</sdf>