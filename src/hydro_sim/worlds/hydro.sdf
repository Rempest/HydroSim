<?xml version="1.0"?>
<sdf version="1.10">

  <world name="hydro">

    <!-- ============================= -->
    <!-- Physics                       -->
    <!-- ============================= -->

    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
 <!-- 
<plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
  <uniform_fluid_density>1000</uniform_fluid_density>
  <enable>rov</enable>
</plugin> 
-->


    <!-- ============================= -->
    <!-- Scene                         -->
    <!-- ============================= -->

    <scene>
      <ambient>0.15 0.20 0.30 1</ambient>
      <background>0.02 0.05 0.10 1</background>

      <fog>
        <color>0.00 0.18 0.30 1</color>
        <type>linear</type>
        <start>15</start>
        <end>120</end>
      </fog>
    </scene>

    <!-- ============================= -->
    <!-- Sun                           -->
    <!-- ============================= -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 100 0 0 0</pose>

      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>0 0 -1</direction>
    </light>

    <!-- ============================= -->
    <!-- Water siurface                  -->
    <!-- ============================= -->


    <model name="water_surface">

  <static>true</static>

  <link name="water">

    <visual name="visual">

      <pose>0 0 10 0 0 0</pose>

      <geometry>

        <plane>

          <normal>0 0 1</normal>

          <size>1000 1000</size>

        </plane>

      </geometry>

      <material>

        <ambient>0.0 0.15 0.25 0.35</ambient>

        <diffuse>0.0 0.25 0.40 0.35</diffuse>

        <specular>0.8 0.8 0.8 1</specular>

      </material>

    </visual>

  </link>

</model>

    <!-- ============================= -->
    <!-- Ocean floor                   -->
    <!-- ============================= -->

    <model name="ocean_floor">

      <static>true</static>

      <link name="floor">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
           <specular>0.05 0.05 0.05 1</specular>

       <pbr>
        <metal>
         <albedo_map>file://materials/stone/seamless_stone_pbr_texture_with_rugged_natural_rock_surface.png</albedo_map>
       </metal>
     </pbr>
    </material>
        </visual>

      </link>

    </model>

    <!-- ================================= -->
    <!-- Reef                   -->
    <!-- ================================= -->

    <!--rocks -->

    <include>
      <name>rock_1</name>
      <uri>model://rocks</uri>
      <pose>-7.8 5.8 0.5 0 0 0.6</pose>
    </include>


    <include>
      <name>rock_2</name>
      <uri>model://rocks</uri>
      <pose>4.5 2.4 0.5 0 0 1.4</pose>
    </include>

      <include>
      <name>rock_3</name>
      <uri>model://rocks</uri>
      <pose>5.8 1.5 0.5 0 0 -0.5</pose>
    </include>

    <include>
      <name>rock_4</name>
      <uri>model://rocks</uri>
      <pose>-4.0 -6.7 0.5 0 0 0.9</pose>
    </include>

    <include>
      <name>rock_5</name>
      <uri>model://rocks</uri>
      <pose>7.5 -8.0 0.5 0 0 0.5</pose>
     </include>

   <include>
     <name>rock_6</name>
     <uri>model://rocks</uri>
     <pose>8.8 -7.2 0.5 0 0 -0.8</pose>
   </include>

  <include>
    <name>rock_7</name>
    <uri>model://rocks</uri>
    <pose>0.5 8.2 0.5 0 0 1.3</pose>
  </include>

  <include>
    <name>rock_8</name>
    <uri>model://rocks</uri>
    <pose>8.7 6.6 0.5 0 0 -0.5</pose>
  </include>

  <include>
    <name>rock_9</name>
    <uri>model://rocks</uri>
    <pose>9.5 5.8 0.5 0 0 0.8</pose>
  </include>

   <!-- corals -->

    <include>
      <name>coral1</name>
      <uri>model://corals</uri>
      <pose>-7.0 5.0 0 1.5708 0 0.4</pose>
    </include>

    <include>
      <name>coral2</name>
      <uri>model://corals</uri>
      <pose>5.2 2.9 0 0 0 0.8</pose>
    </include>

    <include>
      <name>coral3</name>
      <uri>model://corals</uri>
      <pose>-3.1 -5.9 0 0 0 -0.6</pose>
    </include>

    <include>
      <name>coral4</name>
      <uri>model://corals</uri>
      <pose>-2.0 -6.9 0 0 0 1.7</pose>
    </include>


     <include>
        <name>coral5</name>
        <uri>model://corals</uri>
        <pose>8.2 -8.3 0 1.5708 0 0.7</pose>
    </include>


    <include>
       <name>coral6</name>
       <uri>model://corals</uri>
       <pose>-0.4 8.7 0 1.5708 0 -0.8</pose>
    </include>


   <include>
     <name>coral7</name>
     <uri>model://corals</uri>
     <pose>8.9 6.9 0 1.5708 0 0.3</pose>
   </include>


 

    <!-- seastars-->


    <include>
      <name>seastar1</name>
      <uri>model://seastar</uri>
      <pose>-8.4 4.1 0.05 1.5708 0 0.2</pose>
    </include>


    <include>
      <name>seastar2</name>
      <uri>model://seastar</uri>
      <pose>4.1 1.0 0.05 1.5708 0 -1.2</pose>
    </include>

    <include>
      <name>seastar3</name>
      <uri>model://seastar</uri>
      <pose>-5.4 -7.4 0.05 1.5708 0 1.9</pose>
    </include>

    <include>
      <name>seastar4</name>
      <uri>model://seastar</uri>
      <pose>8.7 -8.8 0.05 1.5708 0 1.4</pose>
    </include>

    <include>
      <name>seastar5</name>
      <uri>model://seastar</uri>
      <pose>-0.9 7.4 0.05 1.5708 0 2.4</pose>
    </include>

    <include>
      <name>seastar6</name>
      <uri>model://seastar</uri>
      <pose>8.0 5.6 0.05 1.5708 0 -0.9</pose>
    </include>

    <!-- seaweed-->
   <include>
      <name>seaweed1</name>
      <uri>model://seaweed</uri>
      <pose>-6.3 4.5 0 0 0 -0.4</pose>
   </include>


    <include>
      <name>seaweed2</name>
      <uri>model://seaweed</uri>
      <pose>6.2 3.2 0 0 0 0.9</pose>
    </include>


    <include>
      <name>seaweed3</name>
      <uri>model://seaweed</uri>
      <pose>-4.8 -5.5 0 0 0 0.2</pose>
    </include>

    <include>
      <name>seaweed4</name>
      <uri>model://seaweed</uri>
      <pose>7.1 -7.3 0 0 0 -0.2</pose>
    </include>

    <include>
      <name>seaweed5</name>
      <uri>model://seaweed</uri>
      <pose>1.2 7.7 0 0 0 0.5</pose>
    </include>


   <include>
     <name>seaweed6</name>
     <uri>model://seaweed</uri>
     <pose>9.4 7.4 0 0 0 -0.4</pose>
   </include>

  </world>

</sdf>